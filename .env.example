# Codentry — environment variables
#
# Copy this file to `.env` at the repo root (and/or into apps/web and
# services/ai-review, per each service's own needs) and fill in real values.
# Never commit `.env` — it's gitignored.
#
# This file documents the FULL eventual variable surface across all phases,
# not just what's used so far, so nothing is silently assumed to exist later.

# ---- Shared ----
NODE_ENV=development

# ---- apps/web (Phase 1/2) ----
# Base URL of the services/ai-review backend. Marked NEXT_PUBLIC because the
# backend's base URL is not itself a secret (only credentials are) — only
# apps/web reads it, server-side, for the webhook forward and the internal
# installations view; nothing here requires it to actually be used
# client-side yet.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Phase 2: GitHub webhook signature verification (apps/web only) ----
# HMAC-SHA256 secret configured on the GitHub App's webhook settings page.
# Verified against the RAW request body in app/api/github/webhook/route.ts.
GITHUB_WEBHOOK_SECRET=

# ---- Phase 2: internal Vercel -> Render boundary (both services) ----
# Deliberately distinct from GITHUB_WEBHOOK_SECRET — compromising one must
# not compromise the other. Sent as the X-Codentry-Internal-Secret header.
CODENTRY_INTERNAL_WEBHOOK_SECRET=

# ---- Phase 2: GitHub App authentication (services/ai-review only) ----
# Not yet called by the Phase 2 pipeline (see app/github_auth.py) — the
# placeholder background task never calls the GitHub API. Implemented and
# unit-tested now so Phase 3/5 have working auth to build on.
GITHUB_APP_ID=
# PEM contents. Most platform env var UIs don't accept real newlines —
# store with literal "\n" sequences (e.g. "-----BEGIN...\nMIIEvQ...\n-----END...")
# and app/github_auth.py's normalize_private_key() un-escapes it before use.
GITHUB_PRIVATE_KEY=

# ---- services/ai-review (Phase 1) ----
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# ---- Phase 2: Supabase (services/ai-review only; also used from Phase 9 for pgvector) ----
# If both are unset, services/ai-review falls back to an in-memory store
# with a loud startup warning — useful for local dev, NOT for anything that
# needs data to survive a restart. See supabase/README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Not read by any code yet. Reserved for a possible future client-side
# (browser) read path; backend-only SUPABASE_SERVICE_ROLE_KEY is what
# services/ai-review actually uses.
SUPABASE_ANON_KEY=

# ---- Phase 0: fail-closed production + durable worker (services/ai-review) ----
# ENVIRONMENT other than development/test (including typos) REQUIRES
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and CODENTRY_INTERNAL_WEBHOOK_SECRET,
# or the service refuses to start. The in-memory store is dev/test only.
# WORKER_ENABLED=true
# WORKER_POLL_SECONDS=2.0
# JOB_LEASE_SECONDS=600
# JOB_MAX_ATTEMPTS=3

# ---- Phase 0: internal debug pages (apps/web only) ----
# /internal/* is a 404 unless INTERNAL_PAGES_ENABLED=true, then HTTP Basic auth.
# Enabled without credentials => 503 (fails closed).
# INTERNAL_PAGES_ENABLED=false
# INTERNAL_PAGES_USER=
# INTERNAL_PAGES_PASSWORD=

# ---- Reserved. There is NO AI review in this codebase; nothing reads this. ----
CLAUDE_API_KEY=
