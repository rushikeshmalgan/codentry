# Codentry — environment variables
#
# Copy this file to `.env` at the repo root (and/or into apps/web and
# services/ai-review, per each service's own .env.example) and fill in real
# values. Never commit `.env` — it's gitignored.
#
# This file documents the FULL eventual variable surface across all phases,
# not just what Phase 1 uses, so nothing is silently assumed to exist later.

# ---- Shared ----
NODE_ENV=development

# ---- apps/web (Phase 1) ----
# Base URL of the services/ai-review backend. Points at your local FastAPI
# dev server by default.
AI_REVIEW_SERVICE_URL=http://localhost:8000

# ---- services/ai-review (Phase 1) ----
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# ---- Not used until Phase 2 (GitHub App integration) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Shared secret for the Vercel -> Render internal handoff call. Distinct from
# GITHUB_WEBHOOK_SECRET so compromising one doesn't compromise the other.
INTERNAL_HANDOFF_SECRET=

# ---- Not used until Phase 2 (Supabase) / Phase 9 (pgvector) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Not used until Phase 4 (Claude AI review engine) ----
CLAUDE_API_KEY=
